#!/bin/bash
# Brewfile hash: {{ include (joinPath .chezmoi.workingTree "Brewfile") | sha256sum }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"
# --adopt: take over apps already in /Applications instead of failing on them.
# --no-upgrade: only install what's missing; upgrades happen via `upgrade`.
export HOMEBREW_CASK_OPTS="--adopt"
brew bundle --no-upgrade --file={{ joinPath .chezmoi.workingTree "Brewfile" | quote }}
