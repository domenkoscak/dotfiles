theme = TokyoNight Night

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

window-padding-x = 8
window-padding-y = 4
window-save-state = always
macos-titlebar-style = transparent

shell-integration = zsh
confirm-close-surface = false

# macOS-native text navigation (paired with bindkeys in ~/.zshrc):
#   Option + Left/Right  -> jump by word          (ESC b / ESC f)
#   Cmd    + Left/Right  -> start / end of line   (Ctrl-A / Ctrl-E)
#   Option + Backspace   -> delete previous word  (Ctrl-W)
#   Cmd    + Backspace   -> delete to line start  (Ctrl-U)
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = alt+backspace=text:\x17
keybind = cmd+backspace=text:\x15
