[user]
	name = Domen Koščak
	email = domen.koscak@zerodays.dev
	# Public half of the 1Password SSH key; 1Password does the signing.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICiUCIQyBEYI1hIVTKsazhBQX2iLZl50qaTL7HPwfEZh

# Repos under ~/Documents/Personal use the personal email.
[includeIf "gitdir:~/Documents/Personal/"]
	path = ~/.config/git/config-personal

[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[init]
	defaultBranch = master
[pull]
	rebase = true          # no merge commits from pulls
[rebase]
	autoStash = true
[fetch]
	prune = true           # drop branches deleted on the remote
[merge]
	conflictStyle = zdiff3 # also show the original in conflicts
[rerere]
	enabled = true         # remember how conflicts were resolved
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate  # recent branches first

[push]
	autoSetupRemote = true
